node {

    stage('Checkout') {
        checkout scm
    }

    stage('Install Dependencies') {
        echo 'Installing dependencies...'
        dir('backend') { bat 'npm install' }
        dir('frontend') { bat 'npm install' }
    }

    stage('Build Frontend') {
        echo 'Building the frontend...'
        dir('frontend') { bat 'npm run build' }
    }

    stage('Test Frontend') {
        echo 'Executing frontend tests...'
        dir('frontend') { bat 'npm test -- --passWithNoTests' }
    }

    stage('Notification') {
        if (currentBuild.result == null || currentBuild.result == 'SUCCESS') {
            echo 'Frontend Scripted Pipeline Build Passed Successfully!'
        }
    }
}